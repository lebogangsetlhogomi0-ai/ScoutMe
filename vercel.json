{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": { "runtime": "nodejs20.x" }
  },
  "rewrites": [
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": []
}
