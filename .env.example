# ScoutMe Environment Variables
# Copy this file to .env and fill in your real values

# ============================================
# GEMINI API KEY (for Neural Scout Intelligence)
# Get from: https://aistudio.google.com/app/apikey
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# FIREBASE CONFIG (for real authentication)
# Get from: https://console.firebase.google.com
# Leave as-is to run in Demo Mode
# ============================================
# These are set directly in src/firebase.ts
# Replace the placeholder values in that file

# ============================================
# EMAIL CONFIG (for waitlist notifications)
# Optional - app works without this
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
