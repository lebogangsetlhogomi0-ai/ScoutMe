rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any auth user can read; own profile write by self;
    // social writes (followers/following updates) by any auth user
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == "lebosetlhogomi.scoutme@gmail.com" ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followers', 'following', 'votes', 'views', 'fcmToken', 'notificationsEnabled'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == "lebosetlhogomi.scoutme@gmail.com"
      );
    }

    // Posts: any auth user can read; owner creates/deletes;
    // any auth user can update social fields (votes, views, likedBy, comments, etc.)
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['votes', 'views', 'likedBy', 'commentsCount', 'comments',
                    'trending', 'agentBoostedAt', 'agentSpotlightedAt', 'isArchived',
                    'reportedBy', 'savedBy'])
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Club posts: any auth user can read/update social fields; owner creates/deletes
    match /ClubPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Scout reports — only the scout and the player can read
    match /scoutReports/{reportId} {
      allow read: if request.auth != null && (
        resource.data.scoutId == request.auth.uid ||
        resource.data.playerId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.scoutId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.scoutId == request.auth.uid;
    }

    // Ratings — any auth user can read/create; owner can update/delete
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.ratedBy == request.auth.uid;
    }

    // Notifications — any auth user can create; recipient can read and update
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // News — readable by auth users; writes only from platform agent (fetch-news function)
    match /news/{newsId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "lebosetlhogomi.scoutme@gmail.com";
    }

    // Club followers
    match /ClubFollowers/{docId} {
      allow read, write: if request.auth != null;
    }

    // Challenge responses
    match /challengeResponses/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Spotlight posts
    match /spotlightPosts/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
